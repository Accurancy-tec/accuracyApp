<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="ValorRapidoDeposito">
        <item name="android:layout_height">38dp</item>
        <item name="android:background">@drawable/bg_valor_rapido</item>
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:textColor">@color/texto_suave</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="ValorRapidoSelecionado"
        parent="ValorRapidoDeposito">
        <item name="android:background">@drawable/bg_filtro_categoria_selecionado</item>
        <item name="android:textColor">@color/link</item>
    </style>

</resources>