<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <!-- Um só tema para claro e escuro: as cores mudam pelos valores de values/ e values-night/. -->
    <style name="Base.Theme.AccurancyMobileApp" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/superficie_selecionada</item>
        <item name="colorOnPrimaryContainer">@color/text_primary</item>
        <item name="colorSecondary">@color/link</item>
        <item name="colorSurface">@color/card_background</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/superficie_selecionada</item>
        <item name="colorOnSecondaryContainer">@color/text_primary</item>
        <!-- Superfícies do Material 3 na paleta do app (sem o lilás padrão) -->
        <item name="colorSurfaceVariant">@color/card_background_2</item>
        <item name="colorSurfaceContainerLowest">@color/card_background</item>
        <item name="colorSurfaceContainerLow">@color/card_background</item>
        <item name="colorSurfaceContainer">@color/card_background_2</item>
        <item name="colorSurfaceContainerHigh">@color/card_background</item>
        <item name="colorSurfaceContainerHighest">@color/trilho</item>
        <item name="colorOutline">@color/borda_forte</item>
        <item name="colorOutlineVariant">@color/borda</item>
        <item name="colorError">@color/negativo_destaque</item>
        <item name="android:colorBackground">@color/bg_deep</item>
        <item name="android:windowBackground">@color/bg_deep</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_placeholder</item>
        <item name="android:windowLightStatusBar">@bool/barras_sistema_claras</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">@bool/barras_sistema_claras</item>
    </style>

    <style name="AporteLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textColor">@color/texto_fraco</item>
        <item name="android:textSize">10sp</item>
    </style>

    <style name="AporteChip" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginHorizontal">3dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/link</item>
        <item name="android:textSize">13sp</item>
        <item name="backgroundTint">@color/card_background</item>
        <item name="strokeColor">@color/primary_blue</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">10dp</item>
    </style>

    <style name="AporteChip.Selected">
        <item name="backgroundTint">@color/superficie_selecionada</item>
        <item name="strokeColor">@color/primary_blue</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Bottom sheet cards (slide-up): transparent window so the rounded card drawable shows. -->
    <style name="ThemeOverlay.Accurancy.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Accurancy.BottomSheet</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>

    <style name="Widget.Accurancy.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
        <item name="backgroundTint">@android:color/transparent</item>
    </style>

    <style name="Theme.AccurancyMobileApp" parent="Base.Theme.AccurancyMobileApp" />
</resources>