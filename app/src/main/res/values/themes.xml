<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.AccurancyMobileApp" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->

    </style>

    <style name="AporteLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textColor">#8A94A6</item>
        <item name="android:textSize">10sp</item>
    </style>

    <style name="AporteChip" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginHorizontal">3dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">#60A5FA</item>
        <item name="android:textSize">13sp</item>
        <item name="backgroundTint">#111A2B</item>
        <item name="strokeColor">#1E3A8A</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">10dp</item>
    </style>

    <style name="AporteChip.Selected">
        <item name="backgroundTint">#1D3A8A</item>
        <item name="strokeColor">#3B82F6</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <style name="Theme.AccurancyMobileApp" parent="Base.Theme.AccurancyMobileApp" />
</resources>