<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingMultiplier="1.15"
        android:text="O valor entra só nesta simulação e conta como dinheiro depositado no cálculo do resultado. O seu saldo geral não muda."
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/edtValorDepositoSimulacao"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_campo_carteira"
        android:hint="R$ 0,00"
        android:importantForAutofill="no"
        android:inputType="number"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:singleLine="true"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_placeholder"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvErroDepositoSimulacao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/negativo_destaque"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
