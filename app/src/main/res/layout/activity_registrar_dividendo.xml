<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootRegistrarDividendo"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_deep"
    android:orientation="vertical"
    android:paddingTop="12dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingHorizontal="14dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="44dp">

                <ImageView
                    android:id="@+id/btnVoltarDividendo"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentStart="true"
                    android:background="@drawable/bg_icon_button"
                    android:clickable="true"
                    android:contentDescription="Voltar"
                    android:focusable="true"
                    android:padding="11dp"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_centerInParent="true"
                    android:gravity="center"
                    android:text="Registrar dividendo"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </RelativeLayout>

            <!-- Ativo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_carteira_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tvDividendoTicker"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ATIVO"
                    android:textColor="#9BAAC0"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDividendoNome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Ativo"
                    android:textColor="#F1F5FC"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Dividendos não alteram a quantidade de cotas ou ações: o valor recebido entra no seu saldo."
                    android:textColor="#8D9DB3"
                    android:textSize="11sp" />

            </LinearLayout>

            <!-- Tipo de provento -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Tipo de provento"
                android:textColor="#9CB4D2"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:weightSum="3">

                <TextView
                    android:id="@+id/chipDividendos"
                    style="@style/ValorRapidoDeposito"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="Dividendos" />

                <TextView
                    android:id="@+id/chipJcp"
                    style="@style/ValorRapidoDeposito"
                    android:layout_width="0dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="JCP" />

                <TextView
                    android:id="@+id/chipRendimento"
                    style="@style/ValorRapidoDeposito"
                    android:layout_width="0dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="Rendimento" />

            </LinearLayout>

            <!-- Valor recebido -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_adicionar_saldo"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quanto você recebeu?"
                    android:textColor="#9CB4D2"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/etValorDividendo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@null"
                    android:gravity="center"
                    android:hint="R$ 0,00"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="18"
                    android:singleLine="true"
                    android:text="R$ 0,00"
                    android:textColor="@color/text_primary"
                    android:textColorHint="#7086A5"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDividendoAviso"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text=" "
                    android:textColor="#829BB9"
                    android:textSize="11sp" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_buy_asset_notice"
                android:padding="10dp"
                android:text="Registro simulado para fins educacionais. Informe o valor líquido que você recebeu; não é necessário informar quantidade nem preço."
                android:textColor="#9CB4D2"
                android:textSize="11sp" />

        </LinearLayout>

    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/btnConfirmarDividendo"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_btn_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Registrar dividendo"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
