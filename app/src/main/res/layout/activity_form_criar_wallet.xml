<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_deep">

    <!-- CONTEÚDO DA TELA -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollNovaCarteira"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/footerNovaCarteira">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="17dp"
            android:paddingEnd="17dp"
            android:paddingTop="20dp">

            <!-- CABEÇALHO -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="42dp">

                <ImageButton
                    android:id="@+id/btnVoltarNovaCarteira"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_btn_icone"
                    android:src="@drawable/ic_arrow_back"
                    android:contentDescription="Voltar"
                    android:padding="10dp"
                    app:tint="#AAB8C8"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nova carteira"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- NOME DA CARTEIRA -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Nome da carteira"
                android:textColor="#A9C5E5"
                android:textSize="12sp"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/edtNomeCarteira"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_campo_carteira"
                android:hint="Ex.: Reserva de emergência"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#75869D"
                android:textSize="14sp"
                android:singleLine="true"
                android:inputType="textCapSentences"/>

            <!-- TIPO DA CARTEIRA -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Tipo de carteira"
                android:textColor="#A9C5E5"
                android:textSize="12sp"
                android:textStyle="bold"/>

            <!-- PRIMEIRA LINHA DE TIPOS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRendaFixa"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="45dp"
                    android:text="Renda fixa"
                    android:textColor="#A9C5E5"
                    android:textSize="12sp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="15dp"
                    app:cornerRadius="22dp"
                    app:strokeColor="#29384B"
                    app:strokeWidth="1dp"
                    app:backgroundTint="#081426" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRendaVariavel"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="45dp"
                    android:layout_marginStart="8dp"
                    android:text="Renda variável"
                    android:textColor="#398BFF"
                    android:textSize="12sp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="15dp"
                    app:cornerRadius="22dp"
                    app:strokeColor="#2463E8"
                    app:strokeWidth="1dp"
                    app:backgroundTint="#102443" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCripto"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="45dp"
                    android:layout_marginStart="8dp"
                    android:text="Cripto"
                    android:textColor="#A9C5E5"
                    android:textSize="12sp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="15dp"
                    app:cornerRadius="22dp"
                    app:strokeColor="#29384B"
                    app:strokeWidth="1dp"
                    app:backgroundTint="#081426" />

            </LinearLayout>

            <!-- SEGUNDA LINHA DE TIPOS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnInternacional"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="45dp"
                    android:text="Internacional"
                    android:textColor="#A9C5E5"
                    android:textSize="12sp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="15dp"
                    app:cornerRadius="22dp"
                    app:strokeColor="#29384B"
                    app:strokeWidth="1dp"
                    app:backgroundTint="#081426" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMista"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="45dp"
                    android:layout_marginStart="8dp"
                    android:text="Mista"
                    android:textColor="#A9C5E5"
                    android:textSize="12sp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="15dp"
                    app:cornerRadius="22dp"
                    app:strokeColor="#29384B"
                    app:strokeWidth="1dp"
                    app:backgroundTint="#081426" />

            </LinearLayout>

            <!-- META DA CARTEIRA -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Meta da carteira"
                android:textColor="#A9C5E5"
                android:textSize="12sp"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/edtMetaCarteira"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_campo_carteira"
                android:hint="R$ 0,00"
                android:inputType="number"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#75869D"
                android:textSize="16sp"
                android:textStyle="bold"
                android:singleLine="true"/>

            <!-- ESTILO DA CARTEIRA -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Estilo da carteira"
                android:textColor="#A9C5E5"
                android:textSize="12sp"
                android:textStyle="bold"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <!-- CARTEIRA SIMULADA -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardCarteiraSimulada"
                    android:layout_width="0dp"
                    android:layout_height="133dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="#102443"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#2463E8"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="13dp">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:background="@drawable/bg_icone_estilo"
                            android:src="@drawable/ic_flask"
                            android:padding="7dp"
                            app:tint="#55A5FF"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Simulada"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="Teste estratégias sem usar dinheiro de verdade"
                            android:textColor="#A9C5E5"
                            android:textSize="11sp"
                            android:lineSpacingExtra="1dp"/>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- CARTEIRA REAL -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardCarteiraReal"
                    android:layout_width="0dp"
                    android:layout_height="133dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="#101F34"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#25364D"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="13dp">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:background="@drawable/bg_icone_estilo"
                            android:src="@drawable/ic_shield"
                            android:padding="7dp"
                            app:tint="#A9B9CD"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Real"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="Acompanhe os seus investimentos reais"
                            android:textColor="#A9C5E5"
                            android:textSize="11sp"
                            android:lineSpacingExtra="1dp"/>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- RODAPÉ FIXO -->
    <LinearLayout
        android:id="@+id/footerNovaCarteira"
        android:layout_width="match_parent"
        android:layout_height="85dp"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="17dp"
        android:paddingEnd="17dp"
        android:background="#0B192D"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCriarCarteira"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Criar carteira"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="#2863EA"
            app:cornerRadius="13dp"
            app:elevation="0dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
