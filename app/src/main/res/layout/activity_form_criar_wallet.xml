<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raizNovaCarteira"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_deep">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollNovaCarteira"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/footerNovaCarteira"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="17dp"
            android:paddingTop="8dp"
            android:paddingEnd="17dp">

            <!-- CABEÇALHO -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="48dp">

                <ImageButton
                    android:id="@+id/btnVoltarNovaCarteira"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_btn_icone"
                    android:contentDescription="Voltar"
                    android:padding="10dp"
                    android:src="@drawable/ic_arrow_back"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nova carteira"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- NOME -->
            <TextView
                style="@style/RotuloFormularioCarteira"
                android:layout_marginTop="12dp"
                android:labelFor="@id/edtNomeCarteira"
                android:text="Nome da carteira" />

            <EditText
                android:id="@+id/edtNomeCarteira"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_campo_carteira"
                android:hint="Ex.: Reserva de emergência"
                android:importantForAutofill="no"
                android:inputType="textCapSentences"
                android:maxLength="60"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_placeholder"
                android:textSize="14sp" />

            <!-- REAL OU SIMULADA -->
            <TextView
                style="@style/RotuloFormularioCarteira"
                android:layout_marginTop="18dp"
                android:text="Tipo de carteira" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardCarteiraReal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:checkable="true"
                    android:clickable="true"
                    android:focusable="true"
                    android:minHeight="128dp"
                    app:cardBackgroundColor="@color/card_background"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:checkedIcon="@null"
                    app:strokeColor="@color/borda"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="13dp">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:background="@drawable/bg_icone_estilo"
                            android:importantForAccessibility="no"
                            android:padding="7dp"
                            android:src="@drawable/ic_shield"
                            app:tint="@color/link" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Real"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:lineSpacingExtra="1dp"
                            android:text="Usa o saldo geral da conta e entra no seu patrimônio"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardCarteiraSimulada"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:checkable="true"
                    android:clickable="true"
                    android:focusable="true"
                    android:minHeight="128dp"
                    app:cardBackgroundColor="@color/card_background"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:checkedIcon="@null"
                    app:strokeColor="@color/borda"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="13dp">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:background="@drawable/bg_icone_estilo"
                            android:importantForAccessibility="no"
                            android:padding="7dp"
                            android:src="@drawable/ic_flask"
                            app:tint="@color/link" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Simulada"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:lineSpacingExtra="1dp"
                            android:text="Tem um saldo próprio para testar estratégias"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- SALDO INICIAL (só na simulada) -->
            <LinearLayout
                android:id="@+id/blocoSaldoInicial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/RotuloFormularioCarteira"
                    android:layout_marginTop="18dp"
                    android:labelFor="@id/edtSaldoInicial"
                    android:text="Saldo inicial da simulação" />

                <EditText
                    android:id="@+id/edtSaldoInicial"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/bg_campo_carteira"
                    android:hint="R$ 0,00"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_placeholder"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="1dp"
                    android:text="Esse dinheiro fictício fica só nesta carteira. Ele não sai do seu saldo geral e as compras da simulação usam apenas ele."
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- ESTILO -->
            <TextView
                style="@style/RotuloFormularioCarteira"
                android:layout_marginTop="18dp"
                android:text="O que a carteira vai receber" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/grupoEstilosCarteira"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:chipSpacingHorizontal="8dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipRendaVariavel"
                    style="@style/ChipEstiloCarteira"
                    android:checked="true"
                    android:text="Renda variável" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipRendaFixa"
                    style="@style/ChipEstiloCarteira"
                    android:text="Renda fixa" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCripto"
                    style="@style/ChipEstiloCarteira"
                    android:text="Cripto" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipInternacional"
                    style="@style/ChipEstiloCarteira"
                    android:text="Internacional" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipMista"
                    style="@style/ChipEstiloCarteira"
                    android:text="Mista" />
            </com.google.android.material.chip.ChipGroup>

            <TextView
                android:id="@+id/tvDescricaoEstilo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="1dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <!-- META -->
            <TextView
                style="@style/RotuloFormularioCarteira"
                android:layout_marginTop="18dp"
                android:labelFor="@id/edtMetaCarteira"
                android:text="Meta da carteira (opcional)" />

            <EditText
                android:id="@+id/edtMetaCarteira"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_campo_carteira"
                android:hint="R$ 0,00"
                android:importantForAutofill="no"
                android:inputType="number"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_placeholder"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvErroNovaCarteira"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_aviso_erro"
                android:padding="12dp"
                android:textColor="@color/negativo_destaque"
                android:textSize="13sp"
                android:visibility="gone" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- RODAPÉ FIXO -->
    <LinearLayout
        android:id="@+id/footerNovaCarteira"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_deep"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="17dp"
        android:paddingTop="12dp"
        android:paddingEnd="17dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="50dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCriarCarteira"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Criar carteira"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@color/primary_blue"
                app:cornerRadius="13dp"
                app:elevation="0dp" />

            <ProgressBar
                android:id="@+id/progressCriarCarteira"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:elevation="4dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/white"
                android:visibility="gone" />

        </FrameLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
