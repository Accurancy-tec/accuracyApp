<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#081426">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Cabeçalho -->
        <LinearLayout
            android:id="@+id/cabecalhoRendaFixa"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginTop="30dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageButton
                android:id="@+id/btnVoltarRendaFixa"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_btn_icone"
                android:contentDescription="Voltar"
                android:src="@drawable/ic_arrow_back"
                app:tint="#9BAAC0" />

            <TextView
                android:id="@+id/tvTituloRendaFixa"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Renda fixa"
                android:textColor="#F1F5FC"
                android:textSize="16sp"
                android:textStyle="bold" />

            <View
                android:layout_width="36dp"
                android:layout_height="36dp" />

        </LinearLayout>

        <!-- Campo de pesquisa -->
        <LinearLayout
            android:id="@+id/containerBuscaTitulo"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="17dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="17dp"
            android:background="@drawable/bg_carteira_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            app:layout_constraintTop_toBottomOf="@id/cabecalhoRendaFixa"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_busca"
                app:tint="#9BAAC0" />

            <EditText
                android:id="@+id/edtBuscarTitulo"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:background="@android:color/transparent"
                android:hint="Buscar título"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:padding="0dp"
                android:singleLine="true"
                android:textColor="#F1F5FC"
                android:textColorHint="#8291A8"
                android:textSize="12sp" />

            <FrameLayout
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="8dp">

                <ImageButton
                    android:id="@+id/btnFiltrosRendaFixa"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_btn_icone"
                    android:contentDescription="Abrir filtros"
                    android:padding="7dp"
                    android:src="@drawable/ic_filter_list"
                    app:tint="#9BAAC0" />

                <TextView
                    android:id="@+id/tvBadgeFiltrosRf"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/bg_badge_filtro"
                    android:gravity="center"
                    android:textColor="#FFFFFF"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

            </FrameLayout>

        </LinearLayout>

        <!-- Lista de títulos -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvTitulosRendaFixa"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:paddingStart="17dp"
            android:paddingTop="13dp"
            android:paddingEnd="17dp"
            android:paddingBottom="16dp"
            android:overScrollMode="never"
            app:layout_constraintTop_toBottomOf="@id/containerBuscaTitulo"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Carregando -->
        <ProgressBar
            android:id="@+id/progressRendaFixa"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:indeterminateTint="#2563EB"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/containerBuscaTitulo"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Estado vazio / erro -->
        <LinearLayout
            android:id="@+id/estadoVazioRendaFixa"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/containerBuscaTitulo"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/tvEstadoVazioTituloRf"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nenhum título encontrado"
                android:textColor="#F1F5FC"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEstadoVazioMensagemRf"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Tente outra busca."
                android:textColor="#8D9DB3"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnTentarNovamenteRf"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_btn_primary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="24dp"
                android:text="Tentar novamente"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
