<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_carteira_card"
    android:orientation="vertical">

    <!-- Cabeçalho do título -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="13dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="3dp"
                android:layout_height="12dp"
                android:background="#31D9B5" />

            <TextView
                android:id="@+id/tvIndexador"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="LCA"
                android:textColor="#9BAAC0"
                android:textSize="10sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvNomeTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="LCA Pós-Fixado"
            android:textColor="#F1F5FC"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Selos -->
        <LinearLayout
            android:id="@+id/containerSelosTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvNivelTitulo"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:background="@drawable/bg_selo_titulo"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="▮▮ Nível 1"
                android:textColor="#AABBD0"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvGarantiaFgc"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_marginStart="5dp"
                android:background="@drawable/bg_selo_titulo"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="♥ Garantia FGC"
                android:textColor="#AABBD0"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvIsentoIR"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_marginStart="5dp"
                android:background="@drawable/bg_selo_titulo"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="Isento de IR"
                android:textColor="#AABBD0"
                android:textSize="10sp"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

    <!-- Separador -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1E3048" />

    <!-- Informações financeiras -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="11dp"
        android:paddingEnd="14dp"
        android:paddingBottom="13dp">

        <!-- Rentabilidade -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Rentabilidade"
                android:textColor="#8D9DB3"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvRentabilidade"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="88% CDI"
                android:textColor="#31D9B5"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Resgate -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Resgate"
                android:textColor="#8D9DB3"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvLiquidez"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No vencimento"
                android:textColor="#DCE5F2"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Aplicação mínima -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Aplicação mínima"
                android:textColor="#8D9DB3"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvAplicacaoMinima"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="R$ 1.052,00"
                android:textColor="#DCE5F2"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
