<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#0A1628"
    android:fillViewport="true"
    android:maxHeight="620dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="22dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <View
            android:layout_width="38dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="18dp"
            android:background="#53647D" />

        <TextView
            android:id="@+id/tvTituloFiltros"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Filtros e ordenação"
            android:textColor="#F1F5FC"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDescricaoSegmento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Tipo de fundo"
            android:textColor="#AAB8CC"
            android:textSize="13sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgSegmentType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbSegmentAll"
                style="@style/MarketFilterRadioButton"
                android:checked="true"
                android:text="Todos os segmentos" />

            <RadioButton
                android:id="@+id/rbSegmentPapel"
                style="@style/MarketFilterRadioButton"
                android:text="Papel" />

            <RadioButton
                android:id="@+id/rbSegmentTijolo"
                style="@style/MarketFilterRadioButton"
                android:text="Tijolo" />

            <RadioButton
                android:id="@+id/rbSegmentHibrido"
                style="@style/MarketFilterRadioButton"
                android:text="Híbrido" />

            <RadioButton
                android:id="@+id/rbSegmentFof"
                style="@style/MarketFilterRadioButton"
                android:text="FOF" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Ordenar por"
            android:textColor="#AAB8CC"
            android:textSize="13sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgSortBy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbSortName"
                style="@style/MarketFilterRadioButton"
                android:text="Nome" />

            <RadioButton
                android:id="@+id/rbSortPrice"
                style="@style/MarketFilterRadioButton"
                android:text="Preço" />

            <RadioButton
                android:id="@+id/rbSortInvestors"
                style="@style/MarketFilterRadioButton"
                android:text="Número de cotistas" />

            <RadioButton
                android:id="@+id/rbSortDividendYield"
                style="@style/MarketFilterRadioButton"
                android:text="Dividend Yield (12 meses)" />

            <RadioButton
                android:id="@+id/rbSortPvp"
                style="@style/MarketFilterRadioButton"
                android:text="P/VP" />

            <RadioButton
                android:id="@+id/rbSortChange"
                style="@style/MarketFilterRadioButton"
                android:text="Variação percentual" />

            <RadioButton
                android:id="@+id/rbSortVolume"
                style="@style/MarketFilterRadioButton"
                android:text="Volume negociado" />

            <RadioButton
                android:id="@+id/rbSortMarketCap"
                style="@style/MarketFilterRadioButton"
                android:text="Valor de mercado" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Ordem"
            android:textColor="#AAB8CC"
            android:textSize="13sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgSortOrder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbSortOrderDesc"
                style="@style/MarketFilterRadioButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:checked="true"
                android:text="Decrescente" />

            <RadioButton
                android:id="@+id/rbSortOrderAsc"
                style="@style/MarketFilterRadioButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="Crescente" />
        </RadioGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnLimparFiltros"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:backgroundTint="#20334B"
                android:text="Limpar"
                android:textAllCaps="false"
                android:textColor="#F1F5FC" />

            <Button
                android:id="@+id/btnAplicarFiltros"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="#2563EB"
                android:text="Aplicar filtros"
                android:textAllCaps="false"
                android:textColor="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
