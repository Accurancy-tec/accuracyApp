<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_card"
    android:orientation="vertical">

    <View
        android:layout_width="40dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_sheet_handle" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/conteudoSheetRf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="20dp">

            <!-- Título -->
            <RelativeLayout
                android:id="@+id/blocoTituloSheet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="92dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvSheetTipo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Renda fixa"
                        android:textColor="#31D9B5"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSheetNome"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Título"
                        android:textColor="#F1F5F9"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvSheetSeloFgc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_selo_titulo"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="Garantia FGC"
                            android:textColor="#B3C7D9"
                            android:textSize="10sp"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tvSheetSeloIr"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_selo_titulo"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="Isento de IR"
                            android:textColor="#31D9B5"
                            android:textSize="10sp"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>

                <ImageView
                    android:id="@+id/btnFavoritoSheet"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_alignParentEnd="true"
                    android:layout_marginEnd="44dp"
                    android:background="@drawable/bg_icon_button"
                    android:clickable="true"
                    android:contentDescription="Adicionar aos favoritos"
                    android:focusable="true"
                    android:padding="8dp"
                    android:src="@drawable/ic_favorito_vazio" />

                <ImageView
                    android:id="@+id/btnFecharSheet"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_alignParentEnd="true"
                    android:background="@drawable/bg_icon_button"
                    android:clickable="true"
                    android:contentDescription="Fechar"
                    android:focusable="true"
                    android:padding="9dp"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    app:tint="#9BAAC0" />
            </RelativeLayout>

            <!-- Resumo do título -->
            <LinearLayout
                android:id="@+id/blocoResumoSheet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:weightSum="3">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_sheet_info_tile"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rentabilidade"
                        android:textColor="#8D9DB3"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tvSheetRentabilidade"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="—"
                        android:textColor="#31D9B5"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_sheet_info_tile"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Vencimento"
                        android:textColor="#8D9DB3"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tvSheetVencimento"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="—"
                        android:textColor="#F1F5F9"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_sheet_info_tile"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Resgate"
                        android:textColor="#8D9DB3"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tvSheetLiquidez"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="—"
                        android:textColor="#F1F5F9"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Pergunta e saldo -->
            <TextView
                android:id="@+id/tvSheetPergunta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Quanto você deseja investir?"
                android:textColor="#F1F5F9"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSheetSaldo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Saldo disponível: …"
                android:textColor="#9BAAC0"
                android:textSize="13sp" />

            <!-- Campo de valor -->
            <LinearLayout
                android:id="@+id/campoValorSheet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_campo_valor_sheet"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Digite o valor"
                    android:textColor="#8D9DB3"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/etValorSheet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="18"
                    android:paddingHorizontal="0dp"
                    android:paddingVertical="4dp"
                    android:singleLine="true"
                    android:text="R$ 0,00"
                    android:textColor="#F1F5F9"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvSheetAviso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text=" "
                android:textColor="#829BB9"
                android:textSize="12sp" />

            <!-- Atalhos -->
            <HorizontalScrollView
                android:id="@+id/blocoAtalhosSheet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chipSaldoTotal"
                        style="@style/ValorRapidoDeposito"
                        android:layout_width="wrap_content"
                        android:paddingHorizontal="16dp"
                        android:text="Investir saldo total" />

                    <TextView
                        android:id="@+id/chipMinimo"
                        style="@style/ValorRapidoDeposito"
                        android:layout_width="wrap_content"
                        android:layout_marginStart="8dp"
                        android:paddingHorizontal="16dp"
                        android:text="Mínimo" />

                    <TextView
                        android:id="@+id/chip500"
                        style="@style/ValorRapidoDeposito"
                        android:layout_width="wrap_content"
                        android:layout_marginStart="8dp"
                        android:paddingHorizontal="16dp"
                        android:text="R$ 500" />

                    <TextView
                        android:id="@+id/chip1000"
                        style="@style/ValorRapidoDeposito"
                        android:layout_width="wrap_content"
                        android:layout_marginStart="8dp"
                        android:paddingHorizontal="16dp"
                        android:text="R$ 1.000" />
                </LinearLayout>
            </HorizontalScrollView>

            <TextView
                android:id="@+id/tvSheetNota"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_buy_asset_notice"
                android:padding="10dp"
                android:text="Operação simulada para fins educacionais. O valor sai do seu saldo e as condições do título ficam registradas no histórico."
                android:textColor="#9CB4D2"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btnInvestirSheet"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_btn_primary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Investir"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
