<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/detalhesAtivoRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#081426">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#081426">

        <!-- CABEÇALHO -->
        <LinearLayout
            android:id="@+id/cabecalhoDetalhes"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageButton
                android:id="@+id/btnVoltarDetalhes"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_btn_icone"
                android:contentDescription="Voltar"
                android:padding="9dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="#D1DEFF" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Detalhes do ativo"
                android:textColor="#F1F5FC"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnFavoritarAtivo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_btn_icone"
                android:contentDescription="Favoritar ativo"
                android:gravity="center"
                android:text="♥"
                android:textColor="#FFC400"
                android:textSize="23sp" />

        </LinearLayout>

        <!-- CONTEÚDO ROLÁVEL -->
        <ScrollView
            android:id="@+id/scrollDetalhesAtivo"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:fillViewport="false"
            android:overScrollMode="never"
            app:layout_constraintTop_toBottomOf="@id/cabecalhoDetalhes"
            app:layout_constraintBottom_toTopOf="@id/rodapeOperacoes"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="16dp"
                android:paddingBottom="20dp">

                <!-- CARD DE COTAÇÃO -->
                <LinearLayout
                    android:id="@+id/cardCotacaoAtivo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_patrimonio"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- IDENTIFICAÇÃO DO ATIVO -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvIconeAtivo"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_item_icon"
                            android:gravity="center"
                            android:text="P4"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/tvTickerAtivo"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="PETR4"
                                    android:textColor="#FFFFFF"
                                    android:textSize="18sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="7dp"
                                    android:text="▣"
                                    android:textColor="#9BAAC0"
                                    android:textSize="15sp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvNomeAtivo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="end"
                                android:maxLines="2"
                                android:text="PETROBRAS · PN · N2"
                                android:textColor="#B8C9E5"
                                android:textSize="12sp" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvStatusMercado"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_tag_negativo"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:maxWidth="116dp"
                            android:maxLines="1"
                            android:paddingHorizontal="9dp"
                            android:paddingVertical="6dp"
                            android:text="● Mercado fechado"
                            android:textColor="#FFD0D4"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="13dp"
                        android:background="#29476D" />

                    <!-- PREÇO ATUAL -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Preço atual"
                            android:textColor="#B8C9E5"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvVariacaoPrecoAtivo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_tag_positivo"
                            android:paddingHorizontal="9dp"
                            android:paddingVertical="6dp"
                            android:text="↑ 0,00%"
                            android:textColor="#35D7B0"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvPrecoAtualAtivo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="11dp"
                            android:text="R$ 56,07"
                            android:textColor="#FFFFFF"
                            android:textSize="19sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

                <!-- ATUALIZAÇÃO DA COTAÇÃO -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp">

                    <TextView
                        android:id="@+id/tvUltimaAtualizacao"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Última atualização: aguardando dados"
                        android:textColor="#AFC1DE"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/btnAtualizarCotacao"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:padding="7dp"
                        android:text="Atualizar"
                        android:textColor="#2992FF"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- TÍTULO DA POSIÇÃO -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Minha posição"
                        android:textColor="#F1F5FC"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnInfoMinhaPosicao"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:gravity="center"
                        android:text="ⓘ"
                        android:textColor="#2992FF"
                        android:textSize="22sp" />

                </LinearLayout>

                <!-- CARD MINHA POSIÇÃO -->
                <LinearLayout
                    android:id="@+id/cardMinhaPosicao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_carteira_card"
                    android:orientation="vertical"
                    android:padding="15dp">

                    <!-- PREÇO MÉDIO -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Preço médio"
                            android:textColor="#B8C9E5"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/btnEditarPrecoMedio"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:gravity="center"
                            android:text="✎"
                            android:textColor="#2992FF"
                            android:textSize="19sp" />

                        <TextView
                            android:id="@+id/tvPrecoMedio"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="R$ 56,04"
                            android:textColor="#2992FF"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- QUANTIDADE -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Quantidade"
                            android:textColor="#B8C9E5"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvQuantidadeAtivo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1"
                            android:textColor="#F1F5FC"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- VALOR DA POSIÇÃO -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Posição"
                            android:textColor="#B8C9E5"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvValorPosicao"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="R$ 56,07"
                            android:textColor="#F1F5FC"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- RENTABILIDADE -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Rentabilidade"
                            android:textColor="#B8C9E5"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvVariacaoRentabilidade"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_tag_negativo"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="5dp"
                            android:text="↓ 0,08%"
                            android:textColor="#FF626B"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvValorRentabilidade"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="9dp"
                            android:text="R$ -0,04"
                            android:textColor="#F1F5FC"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

                <!-- TÍTULO DAS ESTATÍSTICAS -->
                <TextView
                    android:id="@+id/tvTituloEstatisticas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:layout_marginBottom="13dp"
                    android:text="Estatísticas de PETR4"
                    android:textColor="#F1F5FC"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <!-- FILTROS DE PERÍODO -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:fillViewport="false"
                    android:scrollbars="none"
                    android:overScrollMode="never">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/filtroHoje"
                            android:layout_width="70dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_btn_icone"
                            android:gravity="center"
                            android:text="Hoje"
                            android:textColor="#B8C9E5"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/filtro1S"
                            android:layout_width="62dp"
                            android:layout_height="38dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_btn_icone"
                            android:gravity="center"
                            android:text="1S"
                            android:textColor="#B8C9E5"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/filtro1M"
                            android:layout_width="62dp"
                            android:layout_height="38dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_btn_icone"
                            android:gravity="center"
                            android:text="1M"
                            android:textColor="#B8C9E5"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/filtro3M"
                            android:layout_width="66dp"
                            android:layout_height="38dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_btn_icone"
                            android:gravity="center"
                            android:text="3M"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/filtro6M"
                            android:layout_width="62dp"
                            android:layout_height="38dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_btn_icone"
                            android:gravity="center"
                            android:text="6M"
                            android:textColor="#B8C9E5"
                            android:textSize="12sp" />

                    </LinearLayout>
                </HorizontalScrollView>

                <!-- GRÁFICO -->
                <FrameLayout
                    android:id="@+id/containerGraficoAtivo"
                    android:layout_width="match_parent"
                    android:layout_height="230dp"
                    android:layout_marginTop="14dp"
                    android:background="@android:color/transparent" />

                <!-- ESTATÍSTICAS DO PERÍODO -->
                <LinearLayout
                    android:id="@+id/containerResumoEstatisticas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <!-- COLUNA ESQUERDA -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingEnd="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Abertura"
                                android:textColor="#B8C9E5"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvAberturaAtivo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="—"
                                android:textColor="#F1F5FC"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Máxima"
                                android:textColor="#B8C9E5"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvMaximaAtivo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="—"
                                android:textColor="#F1F5FC"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                        </LinearLayout>
                    </LinearLayout>

                    <!-- DIVISÓRIA -->
                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="#29476D" />

                    <!-- COLUNA DIREITA -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Máx. 52S"
                                android:textColor="#B8C9E5"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvMaxima52Semanas"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="—"
                                android:textColor="#F1F5FC"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Mín. 52S"
                                android:textColor="#B8C9E5"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvMinima52Semanas"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="—"
                                android:textColor="#F1F5FC"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- RODAPÉ FIXO DE OPERAÇÕES -->
        <LinearLayout
            android:id="@+id/rodapeOperacoes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="#10203A"
            android:elevation="12dp"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- SALDO PARA INVESTIR -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Saldo para investir"
                    android:textColor="#B8C9E5"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvSaldoInvestir"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="R$ 21,16"
                    android:textColor="#F1F5FC"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnInfoSaldoInvestir"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="8dp"
                    android:gravity="center"
                    android:text="ⓘ"
                    android:textColor="#2992FF"
                    android:textSize="21sp" />

            </LinearLayout>

            <!-- BOTÕES DE OPERAÇÃO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="9dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnVenderAtivo"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_vender"
                    android:gravity="center"
                    android:text="Vender"
                    android:textColor="#FF626B"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnComprarAtivo"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_comprar"
                    android:gravity="center"
                    android:text="Comprar"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
