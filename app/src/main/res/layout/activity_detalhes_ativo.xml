<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#081426">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#081426">

        <!-- Cabeçalho -->
        <LinearLayout
            android:id="@+id/cabecalhoDetalhes"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageButton
                android:id="@+id/btnVoltarDetalhes"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_btn_icone"
                android:contentDescription="Voltar"
                android:src="@drawable/ic_arrow_back"
                app:tint="#9BAAC0" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Detalhes do ativo"
                android:textColor="#F1F5FC"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnFavoritarAtivo"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_btn_icone"
                android:gravity="center"
                android:text=""
                android:textColor="#FFC400"
                android:textSize="20sp"
                android:contentDescription="Favoritar ativo" />

        </LinearLayout>

        <!-- Conteúdo principal rolável -->
        <ScrollView
            android:id="@+id/scrollDetalhesAtivo"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:overScrollMode="never"
            app:layout_constraintTop_toBottomOf="@id/cabecalhoDetalhes"
            app:layout_constraintBottom_toTopOf="@id/rodapeOperacoes"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="20dp">

                <!-- Card de cotação -->
                <LinearLayout
                    android:id="@+id/cardCotacaoAtivo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_patrimonio"
                    android:orientation="vertical"
                    android:padding="17dp">

                    <!-- Identificação do ativo -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvIconeAtivo"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_item_icon"
                            android:gravity="center"
                            android:text="P4"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="11dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvTickerAtivo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="PETR4"
                                android:textColor="#FFFFFF"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvNomeAtivo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="PETROBRAS · PN · N2"
                                android:textColor="#D1DEFF"
                                android:textSize="10sp" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvStatusMercado"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_tag_negativo"
                            android:paddingStart="8dp"
                            android:paddingTop="5dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="5dp"
                            android:text="● Mercado fechado"
                            android:textColor="#FFD0D4"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="11dp"
                        android:background="#4267D5" />

                    <!-- Preço atual -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="PREÇO ATUAL"
                            android:textColor="#D1DEFF"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvVariacaoPrecoAtivo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_tag_positivo"
                            android:paddingStart="8dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="4dp"
                            android:text="▲ 0,00%"
                            android:textColor="#35D7B0"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvPrecoAtualAtivo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="9dp"
                            android:text="R$ 56,07"
                            android:textColor="#FFFFFF"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Última atualização -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvUltimaAtualizacao"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Última atualização: 22h51 ·"
                        android:textColor="#9BAAC0"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/btnAtualizarCotacao"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:padding="3dp"
                        android:text="Atualizar"
                        android:textColor="#57A6FF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Minha posição -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="11dp"
                    android:text="Minha posição"
                    android:textColor="#9BAAC0"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/cardMinhaPosicao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_carteira_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <!-- Preço médio -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Preço médio"
                            android:textColor="#9BAAC0"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvPrecoMedio"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="R$ 56,04"
                            android:textColor="#57A6FF"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- Quantidade -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Quantidade"
                            android:textColor="#9BAAC0"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvQuantidadeAtivo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1"
                            android:textColor="#F1F5FC"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <!-- Posição -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Posição"
                            android:textColor="#9BAAC0"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvValorPosicao"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="R$ 56,07"
                            android:textColor="#F1F5FC"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- Rentabilidade -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Rentabilidade"
                            android:textColor="#9BAAC0"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvVariacaoRentabilidade"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_tag_negativo"
                            android:paddingStart="8dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="4dp"
                            android:text="▼ 0,08%"
                            android:textColor="#FF626B"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvValorRentabilidade"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="R$ -0,04"
                            android:textColor="#F1F5FC"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Estatísticas e filtros -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="17dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Estatísticas de PETR4"
                        android:textColor="#9BAAC0"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/filtro1S"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="6dp"
                        android:text="1S"
                        android:textColor="#9BAAC0"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/filtro1M"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="6dp"
                        android:text="1M"
                        android:textColor="#9BAAC0"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/filtro3M"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background=""
                        android:paddingHorizontal="9dp"
                        android:paddingVertical="6dp"
                        android:text="3M"
                        android:textColor="#57A6FF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/filtro6M"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="6dp"
                        android:text="6M"
                        android:textColor="#9BAAC0"
                        android:textSize="11sp" />

                </LinearLayout>

                <!-- Gráfico: adicionar o Vico posteriormente -->
                <FrameLayout
                    android:id="@+id/containerGraficoAtivo"
                    android:layout_width="match_parent"
                    android:layout_height="190dp"
                    android:layout_marginTop="8dp"
                    android:background="@android:color/transparent" />

            </LinearLayout>
        </ScrollView>

        <!-- Rodapé fixo com saldo e operações -->
        <LinearLayout
            android:id="@+id/rodapeOperacoes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="#10203A"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Saldo para investir"
                    android:textColor="#9BAAC0"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvSaldoInvestir"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="R$ 21,16"
                    android:textColor="#F1F5FC"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnVenderAtivo"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_vender"
                    android:gravity="center"
                    android:text="Vender"
                    android:textColor="#FF626B"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnComprarAtivo"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="9dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_comprar"
                    android:gravity="center"
                    android:text="Comprar"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
