<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#081426">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Cabeçalho -->
        <LinearLayout
            android:id="@+id/cabecalhoRendaVariavel"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginTop="30dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageButton
                android:id="@+id/btnVoltarRendaVariavel"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_btn_icone"
                android:contentDescription="Voltar"
                android:src="@drawable/ic_arrow_back"
                app:tint="#9BAAC0" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Renda variável"
                android:textColor="#F1F5FC"
                android:textSize="16sp"
                android:textStyle="bold" />

            <View
                android:layout_width="36dp"
                android:layout_height="36dp" />

        </LinearLayout>

        <!-- Conteúdo -->
        <ScrollView
            android:id="@+id/scrollRendaVariavel"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:overScrollMode="never"
            app:layout_constraintTop_toBottomOf="@id/cabecalhoRendaVariavel"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="20dp">

                <!-- Pesquisa -->
                <LinearLayout
                    android:id="@+id/containerPesquisaAtivo"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_carteira_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_busca"
                        app:tint="#9BAAC0" />

                    <EditText
                        android:id="@+id/edtPesquisarAtivo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="9dp"
                        android:background="@android:color/transparent"
                        android:hint="Empresa ou código do ativo"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:padding="0dp"
                        android:singleLine="true"
                        android:textColor="#F1F5FC"
                        android:textColorHint="#71839D"
                        android:textSize="12sp" />

                </LinearLayout>

                <!-- Abas: listagem geral e favoritos -->
                <LinearLayout
                    android:id="@+id/abasRendaVariavel"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="9dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/abaListagemGeral"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingEnd="12dp">

                        <TextView
                            android:id="@+id/tvAbaListagemGeral"
                            android:layout_width="wrap_content"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="Listagem geral"
                            android:textColor="#3989FF"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="2dp"
                            android:background="#3989FF" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/abaFavoritos"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingStart="7dp"
                        android:paddingEnd="12dp">

                        <TextView
                            android:id="@+id/tvAbaFavoritos"
                            android:layout_width="wrap_content"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="Favoritos"
                            android:textColor="#9BAAC0"
                            android:textSize="12sp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="2dp"
                            android:background="@android:color/transparent" />

                    </LinearLayout>

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#17263D" />

                <!-- Filtros -->
                <LinearLayout
                    android:id="@+id/filtrosAtivos"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="11dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/filtroCategoria"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_filtro_categoria_selecionado"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="Categoria"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/filtroMaisNegociadas"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="7dp"
                        android:background="@drawable/bg_filtro_categoria"
                        android:gravity="center"
                        android:paddingStart="5dp"
                        android:paddingEnd="5dp"
                        android:text="Mais negociadas"
                        android:textColor="#D1DCEB"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/filtroMaioresBaixas"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="7dp"
                        android:background="@drawable/bg_filtro_categoria"
                        android:gravity="center"
                        android:paddingStart="5dp"
                        android:paddingEnd="5dp"
                        android:text="Maiores baixas"
                        android:textColor="#D1DCEB"
                        android:textSize="11sp" />

                </LinearLayout>

                <!-- Primeira linha -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <!-- Ações nacionais -->
                    <LinearLayout
                        android:id="@+id/cardAcoesNacionais"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginEnd="5dp"
                        android:background="@drawable/bg_carteira_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:background="@drawable/bg_categoria_acoes"
                            android:gravity="center"
                            android:text="AÇ"
                            android:textColor="#31D9B5"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="9dp"
                            android:text="Ações Nacionais"
                            android:textColor="#F1F5FC"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Empresas listadas na B3"
                            android:textColor="#9BAAC0"
                            android:textSize="10sp" />

                    </LinearLayout>

                    <!-- FIIs -->
                    <LinearLayout
                        android:id="@+id/cardFundosImobiliarios"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp"
                        android:background="@drawable/bg_carteira_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:background="@drawable/bg_categoria_fii"
                            android:gravity="center"
                            android:text="FII"
                            android:textColor="#FFC400"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="9dp"
                            android:text="Fundos Imobiliários"
                            android:textColor="#F1F5FC"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="FIIs"
                            android:textColor="#9BAAC0"
                            android:textSize="10sp" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Segunda linha -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <!-- Contratos futuros -->
                    <LinearLayout
                        android:id="@+id/cardContratosFuturos"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginEnd="5dp"
                        android:background="@drawable/bg_carteira_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:background="@drawable/bg_categoria_futuros"
                            android:gravity="center"
                            android:text="FUT"
                            android:textColor="#FF9F43"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="9dp"
                            android:text="Contratos Futuros"
                            android:textColor="#F1F5FC"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Índice, dólar e criptos"
                            android:textColor="#9BAAC0"
                            android:textSize="10sp" />

                    </LinearLayout>

                    <!-- BDRs -->
                    <LinearLayout
                        android:id="@+id/cardAcoesETFsInternacionais"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp"
                        android:background="@drawable/bg_carteira_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:background="@drawable/bg_categoria_bdr"
                            android:gravity="center"
                            android:text="BDR"
                            android:textColor="#8B91FF"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="9dp"
                            android:text="Ações e ETFs Internacionais"
                            android:textColor="#F1F5FC"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="BDRs"
                            android:textColor="#9BAAC0"
                            android:textSize="10sp" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
