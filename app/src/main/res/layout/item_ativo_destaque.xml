<?xml version="1.0" encoding="utf-8"?>
<!-- Card de "Ativos em destaque" do Dashboard (EmphasisAdapter).
     Layout próprio: o item_investiment.xml é compartilhado com Aportes,
     Histórico e Quote, então não foi alterado. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card_ativo"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <!-- Ícone: a cor de fundo e do texto é aplicada no adapter por categoria -->
    <TextView
        android:id="@+id/txtIconAtivo"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_item_icon"
        android:gravity="center"
        android:textColor="#60A5FA"
        android:textSize="13sp"
        android:textStyle="bold"
        tools:text="P4" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtNomeAtivo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Petrobras" />

        <TextView
            android:id="@+id/txtSubtituloAtivo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            tools:text="PETR4 · Ações" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtValorAtivo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="R$ 38,94" />

        <TextView
            android:id="@+id/txtVariacaoAtivo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/green_positive"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="▲ +1,7%" />
    </LinearLayout>
</LinearLayout>
