<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_deep"
    tools:context=".fragments.ProfileFragment">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollPerfil"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Perfil"
                    android:textColor="@color/text_primary"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp">

                    <ImageButton
                        android:id="@+id/btnNotificacoes"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_icon_button"
                        android:contentDescription="Notificações"
                        android:padding="12dp"
                        android:src="@drawable/ic_bell"
                        app:tint="@color/text_primary" />

                    <TextView
                        android:id="@+id/tvBadgeNotificacoes"
                        style="@style/BadgeNotificacao" />
                </FrameLayout>

            </LinearLayout>

            <!-- Foto, nome e e-mail -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="28dp"
                android:background="@drawable/bg_card_perfil"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="24dp">

                <FrameLayout
                    android:layout_width="112dp"
                    android:layout_height="112dp"
                    android:layout_marginBottom="14dp">

                    <ImageView
                        android:id="@+id/imgFotoPerfil"
                        android:layout_width="112dp"
                        android:layout_height="112dp"
                        android:background="@drawable/bg_avatar"
                        android:contentDescription="Foto de perfil"
                        android:padding="24dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_pessoa"
                        app:tint="@color/white" />

                    <TextView
                        android:id="@+id/txtIniciaisPerfil"
                        android:layout_width="112dp"
                        android:layout_height="112dp"
                        android:gravity="center"
                        android:textColor="@color/white"
                        android:textSize="38sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <ProgressBar
                        android:id="@+id/progressoFoto"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:visibility="gone" />

                    <ImageButton
                        android:id="@+id/btnAlterarFoto"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="bottom|end"
                        android:background="@drawable/bg_avatar_button"
                        android:contentDescription="Alterar foto"
                        android:padding="8dp"
                        android:src="@drawable/ic_camera"
                        app:tint="@color/white" />

                </FrameLayout>

                <TextView
                    android:id="@+id/txtNomePerfil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:gravity="center"
                    android:textColor="@color/text_primary"
                    android:textSize="23sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtEmailPerfil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:gravity="center"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEditarPerfil"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Editar perfil"
                    android:textAllCaps="false"
                    android:textColor="@color/blue_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_editar"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconSize="18dp"
                    app:iconTint="@color/blue_primary"
                    app:strokeColor="@color/blue_primary" />

            </LinearLayout>

            <!-- Minha conta: tocar numa linha abre um cartão com a informação -->
            <TextView
                style="@style/Secao"
                android:text="Minha conta" />

            <LinearLayout style="@style/CartaoOpcoes">

                <LinearLayout
                    android:id="@+id/itemNome"
                    style="@style/LinhaOpcao">

                    <ImageView
                        style="@style/LinhaOpcaoIcone"
                        android:src="@drawable/ic_pessoa" />

                    <LinearLayout style="@style/LinhaOpcaoTextos">

                        <TextView
                            style="@style/LinhaOpcaoRotulo"
                            android:text="Nome" />

                        <TextView
                            android:id="@+id/txtNomeConta"
                            style="@style/LinhaOpcaoValor"
                            android:text="—" />
                    </LinearLayout>
                </LinearLayout>

                <View style="@style/LinhaOpcaoDivisor" />

                <LinearLayout
                    android:id="@+id/itemEmail"
                    style="@style/LinhaOpcao">

                    <ImageView
                        style="@style/LinhaOpcaoIcone"
                        android:src="@drawable/ic_email" />

                    <LinearLayout style="@style/LinhaOpcaoTextos">

                        <TextView
                            style="@style/LinhaOpcaoRotulo"
                            android:text="E-mail" />

                        <TextView
                            android:id="@+id/txtEmailConta"
                            style="@style/LinhaOpcaoValor"
                            android:text="—" />

                        <TextView
                            android:id="@+id/txtEmailExtra"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:textColor="@color/green_positive"
                            android:textSize="12sp"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>

                <View style="@style/LinhaOpcaoDivisor" />

                <LinearLayout
                    android:id="@+id/itemTelefone"
                    style="@style/LinhaOpcao">

                    <ImageView
                        style="@style/LinhaOpcaoIcone"
                        android:src="@drawable/ic_telefone" />

                    <LinearLayout style="@style/LinhaOpcaoTextos">

                        <TextView
                            style="@style/LinhaOpcaoRotulo"
                            android:text="Telefone" />

                        <TextView
                            android:id="@+id/txtTelefoneConta"
                            style="@style/LinhaOpcaoValor"
                            android:text="—" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

            <TextView
                style="@style/Secao"
                android:text="Preferências" />

            <LinearLayout style="@style/CartaoOpcoes">

                <LinearLayout
                    android:id="@+id/itemAparencia"
                    style="@style/LinhaOpcao">

                    <ImageView
                        style="@style/LinhaOpcaoIcone"
                        android:src="@drawable/ic_tema" />

                    <LinearLayout style="@style/LinhaOpcaoTextos">

                        <TextView
                            style="@style/LinhaOpcaoTitulo"
                            android:text="Aparência" />

                        <TextView
                            android:id="@+id/txtTemaAtual"
                            style="@style/LinhaOpcaoDetalhe"
                            android:text="Tema escuro" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchTemaEscuro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false"
                        android:importantForAccessibility="no" />
                </LinearLayout>

            </LinearLayout>

            <TextView
                style="@style/Secao"
                android:text="Seus números" />

            <LinearLayout style="@style/CartaoOpcoes">

                <LinearLayout
                    android:id="@+id/itemRelatorio"
                    style="@style/LinhaOpcao">

                    <ImageView
                        style="@style/LinhaOpcaoIcone"
                        android:src="@drawable/ic_relatorio" />

                    <LinearLayout style="@style/LinhaOpcaoTextos">

                        <TextView
                            style="@style/LinhaOpcaoTitulo"
                            android:text="Relatório da conta" />

                        <TextView
                            style="@style/LinhaOpcaoDetalhe"
                            android:text="Resultado, distribuição, movimentação e análise" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

            <TextView
                style="@style/Secao"
                android:text="Ajuda" />

            <LinearLayout style="@style/CartaoOpcoes">

                <LinearLayout
                    android:id="@+id/itemPerguntasFrequentes"
                    style="@style/LinhaOpcao">

                    <ImageView
                        style="@style/LinhaOpcaoIcone"
                        android:src="@drawable/ic_ajuda" />

                    <LinearLayout style="@style/LinhaOpcaoTextos">

                        <TextView
                            style="@style/LinhaOpcaoTitulo"
                            android:text="Perguntas frequentes" />

                        <TextView
                            style="@style/LinhaOpcaoDetalhe"
                            android:text="Carteiras, saldo, operações e conta" />
                    </LinearLayout>
                </LinearLayout>

                <View style="@style/LinhaOpcaoDivisor" />

                <LinearLayout
                    android:id="@+id/itemFaleConosco"
                    style="@style/LinhaOpcao">

                    <ImageView
                        style="@style/LinhaOpcaoIcone"
                        android:src="@drawable/ic_conversa" />

                    <LinearLayout style="@style/LinhaOpcaoTextos">

                        <TextView
                            style="@style/LinhaOpcaoTitulo"
                            android:text="Fale com a equipe" />

                        <TextView
                            style="@style/LinhaOpcaoDetalhe"
                            android:text="Envie uma dúvida e acompanhe a resposta" />
                    </LinearLayout>
                </LinearLayout>

                <View style="@style/LinhaOpcaoDivisor" />

                <LinearLayout
                    android:id="@+id/itemReverTutorial"
                    style="@style/LinhaOpcao">

                    <ImageView
                        style="@style/LinhaOpcaoIcone"
                        android:src="@drawable/ic_tutorial" />

                    <LinearLayout style="@style/LinhaOpcaoTextos">

                        <TextView
                            style="@style/LinhaOpcaoTitulo"
                            android:text="Rever tutorial" />

                        <TextView
                            style="@style/LinhaOpcaoDetalhe"
                            android:text="Um tour rápido pelo app" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

            <TextView
                style="@style/Secao"
                android:text="Segurança" />

            <LinearLayout style="@style/CartaoOpcoes">

                <LinearLayout
                    android:id="@+id/itemAlterarSenha"
                    style="@style/LinhaOpcao">

                    <ImageView
                        style="@style/LinhaOpcaoIcone"
                        android:src="@drawable/ic_cadeado" />

                    <LinearLayout style="@style/LinhaOpcaoTextos">

                        <TextView
                            style="@style/LinhaOpcaoTitulo"
                            android:text="Alterar senha" />

                        <TextView
                            style="@style/LinhaOpcaoDetalhe"
                            android:text="Confirmação por código no seu e-mail" />
                    </LinearLayout>
                </LinearLayout>

                <View style="@style/LinhaOpcaoDivisor" />

                <LinearLayout
                    android:id="@+id/itemAparelhos"
                    style="@style/LinhaOpcao">

                    <ImageView
                        style="@style/LinhaOpcaoIcone"
                        android:src="@drawable/ic_celular" />

                    <LinearLayout style="@style/LinhaOpcaoTextos">

                        <TextView
                            style="@style/LinhaOpcaoTitulo"
                            android:text="Aparelhos conectados" />

                        <TextView
                            style="@style/LinhaOpcaoDetalhe"
                            android:text="Veja onde a conta está aberta e desconecte" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/itemSair"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_card_sair"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="72dp"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:importantForAccessibility="no"
                    android:padding="9dp"
                    android:src="@drawable/ic_sair"
                    app:tint="@color/red_primary" />

                <LinearLayout style="@style/LinhaOpcaoTextos">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sair da conta"
                        android:textColor="@color/red_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Encerrar a sessão neste aparelho"
                        android:textColor="@color/red_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>
</FrameLayout>
