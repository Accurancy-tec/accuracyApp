<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#081426">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:id="@+id/scrollProdutos"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:overScrollMode="never"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="17dp"
                android:paddingTop="20dp"
                android:paddingEnd="17dp"
                android:paddingBottom="20dp">

                <!-- Título + atalho para Favoritos -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Produtos"
                            android:textColor="#F1F5FC"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Prateleira completa de investimentos"
                            android:textColor="#9BAAC0"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/btnFavoritosProdutos"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_btn_icone"
                        android:contentDescription="Abrir meus favoritos"
                        android:padding="9dp"
                        android:src="@drawable/ic_favorito_cheio"
                        app:tint="#FF4D6D" />

                </LinearLayout>

                <!-- Busca geral: acha qualquer produto, em qualquer categoria -->
                <LinearLayout
                    android:id="@+id/containerBuscaGeral"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_carteira_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="6dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_busca"
                        app:tint="#9BAAC0" />

                    <EditText
                        android:id="@+id/edtBuscaGeral"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="Buscar ativo, título ou moeda"
                        android:imeOptions="actionSearch"
                        android:importantForAutofill="no"
                        android:inputType="text"
                        android:padding="0dp"
                        android:singleLine="true"
                        android:textColor="#F1F5FC"
                        android:textColorHint="#8291A8"
                        android:textSize="13sp" />

                    <ImageButton
                        android:id="@+id/btnLimparBuscaGeral"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Limpar busca"
                        android:padding="9dp"
                        android:src="@drawable/ic_limpar_busca"
                        android:visibility="gone"
                        app:tint="#9BAAC0" />
                </LinearLayout>

                <!-- Resultados da busca (aparecem no lugar dos cards) -->
                <LinearLayout
                    android:id="@+id/containerResultadosBusca"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvBuscaGeral"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never" />

                    <TextView
                        android:id="@+id/tvBuscaMensagem"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:gravity="center"
                        android:lineSpacingMultiplier="1.15"
                        android:textColor="#8D9DB3"
                        android:textSize="13sp"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Cards das categorias -->
                <LinearLayout
                    android:id="@+id/containerCardsProdutos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                <!-- Primeira linha -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <!-- Renda fixa -->
                    <LinearLayout
                        android:id="@+id/cardRendaFixa"
                        android:layout_width="0dp"
                        android:layout_height="128dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="5dp"
                        android:background="@drawable/bg_carteira_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="vertical"
                        android:padding="13dp">

                        <TextView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_icone_renda_fixa"
                            android:gravity="center"
                            android:text="CDB"
                            android:textColor="#31D9C0"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="9dp"
                            android:text="Renda Fixa"
                            android:textColor="#F1F5FC"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="CDB, LCI e LCA"
                            android:textColor="#9BAAC0"
                            android:textSize="11sp" />

                    </LinearLayout>

                    <!-- Tesouro direto -->
                    <LinearLayout
                        android:id="@+id/cardTesouroDireto"
                        android:layout_width="0dp"
                        android:layout_height="128dp"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp"
                        android:background="@drawable/bg_carteira_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="vertical"
                        android:padding="13dp">

                        <TextView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_icone_tesouro"
                            android:gravity="center"
                            android:text="TD"
                            android:textColor="#57A6FF"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="9dp"
                            android:text="Tesouro Direto"
                            android:textColor="#F1F5FC"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Títulos públicos nacionais"
                            android:textColor="#9BAAC0"
                            android:textSize="11sp" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Segunda linha -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <!-- Bolsa de valores -->
                    <LinearLayout
                        android:id="@+id/cardBolsaValores"
                        android:layout_width="0dp"
                        android:layout_height="128dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="5dp"
                        android:background="@drawable/bg_carteira_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="vertical"
                        android:padding="13dp">

                        <TextView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_icone_renda_variavel"
                            android:gravity="center"
                            android:text="B3"
                            android:textColor="#31D9A5"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="9dp"
                            android:text="Bolsa de Valores"
                            android:textColor="#F1F5FC"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Ações, FIIs e BDRs"
                            android:textColor="#9BAAC0"
                            android:textSize="11sp" />

                    </LinearLayout>

                    <!-- Criptomoedas -->
                    <LinearLayout
                        android:id="@+id/cardCriptomoedasAportes"
                        android:layout_width="0dp"
                        android:layout_height="128dp"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp"
                        android:background="@drawable/bg_carteira_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="vertical"
                        android:padding="13dp">

                        <TextView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_categoria_cripto"
                            android:gravity="center"
                            android:text="₿"
                            android:textColor="#F7931A"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="9dp"
                            android:text="Criptomoedas"
                            android:textColor="#F1F5FC"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Bitcoin, Ethereum e mais"
                            android:textColor="#9BAAC0"
                            android:textSize="11sp" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Terceira linha -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <!-- Contratos Futuros -->
                    <LinearLayout
                        android:id="@+id/cardFuturosAportes"
                        android:layout_width="0dp"
                        android:layout_height="128dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="5dp"
                        android:background="@drawable/bg_carteira_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="vertical"
                        android:padding="13dp">

                        <TextView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_categoria_futuros"
                            android:gravity="center"
                            android:text="FUT"
                            android:textColor="#FF9F43"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="9dp"
                            android:text="Contratos Futuros"
                            android:textColor="#F1F5FC"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Índice, dólar e juros"
                            android:textColor="#9BAAC0"
                            android:textSize="11sp" />

                    </LinearLayout>

                    <!-- Moedas Estrangeiras -->
                    <LinearLayout
                        android:id="@+id/cardMoedasAportes"
                        android:layout_width="0dp"
                        android:layout_height="128dp"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp"
                        android:background="@drawable/bg_carteira_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="vertical"
                        android:padding="13dp">

                        <TextView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_categoria_moeda"
                            android:gravity="center"
                            android:text="$"
                            android:textColor="#57A6FF"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="9dp"
                            android:text="Moedas Estrangeiras"
                            android:textColor="#F1F5FC"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Dólar, euro, libra e mais"
                            android:textColor="#9BAAC0"
                            android:textSize="11sp" />

                    </LinearLayout>

                </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
