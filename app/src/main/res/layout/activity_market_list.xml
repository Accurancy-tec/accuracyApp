<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#081426">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/cabecalhoAcoesNacionais"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginTop="25dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageButton
                android:id="@+id/btnVoltarAtivosNacionais"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_btn_icone"
                android:contentDescription="Voltar"
                android:src="@drawable/ic_arrow_back"
                app:tint="#9BAAC0" />

            <TextView
                android:id="@+id/tvTituloListaAtivos"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Ativos"
                android:textColor="#F1F5FC"
                android:textSize="16sp"
                android:textStyle="bold" />

            <View
                android:layout_width="36dp"
                android:layout_height="36dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/containerBuscaTitulo"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="17dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="17dp"
            android:background="@drawable/bg_carteira_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="8dp"
            app:layout_constraintTop_toBottomOf="@id/cabecalhoAcoesNacionais"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_busca"
                app:tint="#9BAAC0" />

            <EditText
                android:id="@+id/edtBuscarTitulo"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@android:color/transparent"
                android:hint="Buscar ativo ou ticker..."
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:padding="0dp"
                android:singleLine="true"
                android:textColor="#F1F5FC"
                android:textColorHint="#8291A8"
                android:textSize="12sp" />

            <ImageButton
                android:id="@+id/btnFiltrosAtivos"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_btn_icone"
                android:contentDescription="Abrir filtros"
                android:padding="7dp"
                android:src="@drawable/ic_filter_list"
                app:tint="#9BAAC0" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvTitulosAcoesNacionais"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:paddingStart="17dp"
            android:paddingTop="13dp"
            android:paddingEnd="17dp"
            android:paddingBottom="8dp"
            android:overScrollMode="never"
            app:layout_constraintTop_toBottomOf="@id/containerBuscaTitulo"
            app:layout_constraintBottom_toTopOf="@id/containerPaginacao"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <LinearLayout
            android:id="@+id/containerPaginacao"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="#081426"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <Button
                android:id="@+id/btnPaginaAnterior"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:text="Anterior"
                android:textAllCaps="false"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/tvPaginaAnterior"
                android:layout_width="20dp"
                android:layout_height="37dp"
                android:background="@drawable/bg_btn_primary"
                android:gravity="center"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvPaginaAtual"
                android:layout_width="25dp"
                android:layout_height="45dp"
                android:layout_marginHorizontal="8dp"
                android:background="@drawable/bg_btn_primary"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvProximaPagina"
                android:layout_width="20dp"
                android:layout_height="37dp"
                android:background="@drawable/bg_btn_primary"
                android:gravity="center"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnProximaPagina"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:text="Próxima"
                android:textAllCaps="false"
                android:textColor="#FFFFFF" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
