<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_carteira_item"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Nome da carteira -->
    <TextView
        android:id="@+id/tvNomeCarteira"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_tag_carteira"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp"
        android:text="Renda fixa"
        android:textColor="#63A8FF"
        android:textSize="12sp"
        android:textStyle="bold"/>

    <!-- Saldo -->
    <TextView
        android:id="@+id/tvSaldoCarteira"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="R$ 0,00"
        android:textColor="#F4F7FC"
        android:textSize="22sp"
        android:textStyle="bold"/>

    <!-- Rendimento -->
    <TextView
        android:id="@+id/tvRendimentoCarteira"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="▲ +0,0%"
        android:textColor="#20D6A0"
        android:textSize="13sp"
        android:textStyle="bold"/>

    <!-- Meta e progresso -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvMetaCarteira"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Meta R$ 50.000,00"
            android:textColor="#9CAAC0"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/tvProgressoCarteira"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="58%"
            android:textColor="#D8E0EC"
            android:textSize="12sp"
            android:textStyle="bold"/>

    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressoMetaCarteira"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progress="58"
        android:progressDrawable="@drawable/progresso_carteira"/>

</LinearLayout>